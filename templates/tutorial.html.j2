{% extends "base.html.j2" %}
{% block content %}
<link rel="stylesheet" href="{{ url_for('static', filename='tutorial.css') }}">

<div class="tutorial-shell">
  <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2 shadow-sm" role="status">
    <div><strong><span aria-hidden="true">🧪</span> Practice Mode</strong> — This is a fictional Mini Social replica. Your actions stay in this browser and are never saved to the real platform.</div>
    <button class="btn btn-sm btn-outline-dark" id="resetSandbox" type="button">Reset practice</button>
  </div>

  <header class="tutorial-heading text-center py-3">
    <img src="{{ url_for('static', filename='icon.png') }}" alt="" class="tutorial-logo">
    <h1 class="h2 mt-2 mb-1">Mini Social</h1>
    <p class="text-muted mb-0">Explore the platform and practise at your own pace.</p>
  </header>

  <div class="row g-4">
    <aside class="col-lg-3">
      <div class="card shadow-sm tutorial-sidebar">
        <div class="card-body">
          <h2 class="h6 text-uppercase text-muted">Practice guide</h2>
          <div class="progress mb-3" role="progressbar" aria-label="Tutorial progress" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
            <div class="progress-bar" id="progressBar" style="width:0%"></div>
          </div>
          <p class="small text-muted mb-2" id="progressText">0 of 5 activities completed</p>
          <nav class="nav nav-pills flex-column gap-1" aria-label="Practice activities">
            <button class="nav-link active text-start" data-view="feed" type="button">🏠 Home feed</button>
            <button class="nav-link text-start" data-view="create" type="button">✏️ Create a post</button>
            <button class="nav-link text-start" data-view="reactions" type="button">❤️ React and comment</button>
            <button class="nav-link text-start" data-view="people" type="button">👥 Find and follow people</button>
            <button class="nav-link text-start" data-view="profile" type="button">👤 Explore a profile</button>
            <button class="nav-link text-start" data-view="challenge" type="button">🏁 Final challenge</button>
          </nav>
          <hr>
          <div class="small text-muted">
            <strong>Tip</strong><br>
            Try the buttons and links just as you would on the real platform. You can reset everything whenever you like.
          </div>
        </div>
      </div>
    </aside>

    <main class="col-lg-9">
      <section class="sandbox-view" id="view-feed">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div><h2 class="h4 mb-1">Home feed</h2><p class="text-muted mb-0 small">A sample feed from fictional community members.</p></div>
          <button class="btn btn-primary" type="button" data-go="create">＋ Create a post</button>
        </div>
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
          <div class="btn-group btn-group-sm" role="group" aria-label="Sort practice posts">
            <button class="btn btn-primary feed-sort" data-sort="new" type="button">New</button>
            <button class="btn btn-outline-secondary feed-sort" data-sort="popular" type="button">Popular</button>
          </div>
          <div class="btn-group btn-group-sm" role="group" aria-label="Filter practice posts">
            <button class="btn btn-primary feed-filter" data-filter="all" type="button">All</button>
            <button class="btn btn-outline-secondary feed-filter" data-filter="following" type="button">Following</button>
          </div>
        </div>
        <div id="feedPosts" class="d-grid gap-3" aria-live="polite"></div>
      </section>

      <section class="sandbox-view d-none" id="view-create">
        <div class="mb-3"><h2 class="h4 mb-1">Create a post</h2><p class="text-muted small mb-0">Write something and publish it to this simulated feed.</p></div>
        <div class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-3">
              <div class="avatar avatar-you">Y</div>
              <div><strong>You</strong><div class="small text-muted">@practice_user</div></div>
            </div>
            <form id="createPostForm">
              <label for="postContent" class="form-label">What's on your mind?</label>
              <textarea class="form-control" id="postContent" rows="4" maxlength="500" placeholder="Share an update with the community..." required></textarea>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted"><span id="postCharCount">0</span>/500</small>
                <button class="btn btn-primary" type="submit">Post</button>
              </div>
            </form>
          </div>
        </div>
        <div class="alert alert-light border mt-3 small mb-0"><strong>What happens?</strong> Your practice post appears in the Home feed. It is held only in temporary browser memory.</div>
      </section>

      <section class="sandbox-view d-none" id="view-reactions">
        <div class="mb-3"><h2 class="h4 mb-1">React and comment</h2><p class="text-muted small mb-0">Practise interacting with another member's post.</p></div>
        <div id="reactionPracticePost"></div>
        <div class="tutorial-hint mt-3"><strong>Your task:</strong> Add a reaction, then leave a friendly comment. Try removing your reaction afterwards.</div>
      </section>

      <section class="sandbox-view d-none" id="view-people">
        <div class="mb-3"><h2 class="h4 mb-1">Find and follow people</h2><p class="text-muted small mb-0">Follow accounts to see their posts in your Following feed.</p></div>
        <div id="peopleList" class="row g-3"></div>
        <div class="tutorial-hint mt-3"><strong>Your task:</strong> Follow Alice or Bob. Then return to Home feed and choose Following.</div>
      </section>

      <section class="sandbox-view d-none" id="view-profile">
        <div class="mb-3"><h2 class="h4 mb-1">Explore a profile</h2><p class="text-muted small mb-0">Profiles bring together a member's information, posts and connections.</p></div>
        <div id="profilePanel"></div>
        <div class="tutorial-hint mt-3"><strong>Your task:</strong> Explore the profile, open one of the posts, and use the Follow button.</div>
      </section>

      <section class="sandbox-view d-none" id="view-challenge">
        <div class="mb-3"><h2 class="h4 mb-1">Final practice challenge</h2><p class="text-muted small mb-0">Put what you have learned together without step-by-step prompts.</p></div>
        <div class="card shadow-sm"><div class="card-body">
          <h3 class="h5">Complete these activities</h3>
          <div class="form-check mb-2"><input class="form-check-input challenge-check" type="checkbox" id="challengePost"><label class="form-check-label" for="challengePost">Create a post about one of your hobbies.</label></div>
          <div class="form-check mb-2"><input class="form-check-input challenge-check" type="checkbox" id="challengeReact"><label class="form-check-label" for="challengeReact">React to a community member's post.</label></div>
          <div class="form-check mb-2"><input class="form-check-input challenge-check" type="checkbox" id="challengeComment"><label class="form-check-label" for="challengeComment">Write a comment on a post.</label></div>
          <div class="form-check mb-2"><input class="form-check-input challenge-check" type="checkbox" id="challengeFollow"><label class="form-check-label" for="challengeFollow">Follow at least one person.</label></div>
          <div class="form-check mb-2"><input class="form-check-input challenge-check" type="checkbox" id="challengeProfile"><label class="form-check-label" for="challengeProfile">Visit a member's profile.</label></div>
          <div class="progress mt-3"><div class="progress-bar" id="challengeProgress" style="width:0%"></div></div>
          <p class="small text-muted mt-2 mb-0" id="challengeText">0 of 5 challenge tasks complete.</p>
          <div class="alert alert-success mt-3 d-none" id="challengeComplete">Excellent work! You have completed the Mini Social practice challenge.</div>
        </div></div>
      </section>

      <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <button class="btn btn-outline-secondary btn-sm" id="previousView" type="button">← Previous</button>
        <span class="small text-muted" id="viewLabel">Home feed</span>
        <button class="btn btn-primary btn-sm" id="nextView" type="button">Next →</button>
      </div>
      <div class="small text-muted text-center mt-3">Practice Mode · Fictional accounts · No real posts, reactions, comments or follows are created.</div>
    </main>
  </div>
</div>
<script src="{{ url_for('static', filename='tutorial.js') }}"></script>
{% endblock %}
